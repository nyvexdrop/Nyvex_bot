# ====== NYVEX BOT - configuración ======

# Llave gratis de Google Gemini (sácala en https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Lo que Meta te da al configurar WhatsApp Cloud API (developers.facebook.com)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Token de verificación del webhook (usa este mismo valor en Meta)
VERIFY_TOKEN=nyvex-verify-2026

# Tu número de WhatsApp del negocio con lada internacional SIN + y SIN espacios.
# Ejemplo: 525534897969  (el bot NO contestará mensajes que vengan de este número)
BOT_PHONE_NUMBER=525534897969

# Número donde recibirás el AVISO cuando haya un pedido/compra (puede ser otro teléfono)
# Ejemplo: 525542786413
OWNER_PHONE=

# Modelo de IA (deja el que está si no sabes)
GEMINI_MODEL=gemini-3.6-flash

# Puerto (no lo toques)
PORT=3000

# ====== BASE DE DATOS (opcional pero recomendado) ======
# Base de datos en línea gratis y permanente (Neon). Los pedidos y comprobantes
# se guardan ahí y NO se pierden al reiniciar Render.
# Crea tu base gratis en https://console.neon.tech -> "New project" -> copia la
# "Connection string" (la de Node.js) y pégala aquí.
# Ejemplo: postgresql://usuario:clave@ep-tu-proyecto.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
